{
  "name": "toonboom-harmony-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade Model Context Protocol (MCP) server for Toon Boom Harmony",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "reconstruction:core": ".venv-reconstruction/bin/harmony-reconstruction-core serve",
    "test:python": ".venv-reconstruction/bin/pytest services/reconstruction-core/tests",
    "test:harmony-integration": "npm run build && node scripts/run_harmony_reconstruction_integration.mjs",
    "demo:reconstruction": ".venv-reconstruction/bin/python scripts/reconstruction_demo.py",
    "demo:ai_studio_iter1": "node scripts/demo_ai_studio_iter1.js",
    "demo:ai_studio_iter2": "node scripts/demo_ai_studio_iter2.js",
    "demo:ai_studio_iter3": "node scripts/demo_ai_studio_iter3.js",
    "demo:ai_studio_iter4": "node scripts/demo_ai_studio_iter4.js",
    "demo:factory:phase1": "node scripts/demo_factory_phase1.js",
    "shotfactory:golden": "npm run build && node scripts/run_shot_factory_golden_path.mjs",
    "episodebatch:golden": "npm run build && node scripts/run_episode_golden_path.mjs",
    "episode:assemble": "node scripts/assemble_episode.mjs",
    "autorig:golden": "npm run build && node scripts/run_auto_rig_golden_path.mjs",
    "mohorig:golden": "npm run build && node scripts/run_moho_turnaround_golden_path.mjs",
    "demo:harmony:phase2:offline": "node scripts/demo_phase2_offline.js",
    "reconstruction:prepare-harmony-integration": "node scripts/prepare_harmony_integration.js",
    "ml:core": ".venv-ml-core/bin/uvicorn ml_core.api:app --host 127.0.0.1 --port 8766",
    "test:ml": ".venv-ml-core/bin/pytest services/ml-core/tests",
    "test:ml-runtime": ".venv-ml/bin/pytest services/ml-runtime/tests",
    "test:python:all": "npm run test:python && npm run test:ml && npm run test:ml-runtime",
    "demo:ml": ".venv-ml-core/bin/python scripts/demo_ml_stack.py",
    "demo:ml:mcp": "node scripts/demo_ml_mcp.js",
    "demo:ai_studio_iter5": "node scripts/demo_ai_studio_iter5.js",
    "demo:capture": "node scripts/demo_harmony_action_recorder.mjs",
    "test:harmony-capture-real": "jest tests/integration/harmonyActionRecorder.realHarmony.smoke.test.ts",
    "test:week1": "jest tests/integration/week1SmokeGate.test.ts",
    "test:registry": "jest tests/capabilityRegistryGate.test.ts",
    "test:evidence": "jest tests/evidenceIntegrity.test.ts",
    "test:gates": "jest tests/capabilityRegistryGate.test.ts tests/evidenceIntegrity.test.ts",
    "test:moho_factory": "jest tests/mohoShowBibleSchema.test.ts tests/mohoShowBibleLoader.test.ts tests/mohoCrossReferenceGating.test.ts tests/mohoScenePlanSchema.test.ts tests/mohoRetakeManifestSchema.test.ts tests/mohoPerformancePirSchema.test.ts tests/mohoShowBibleDeterminism.test.ts tests/integration/mohoShowBibleEndToEnd.test.ts",
    "test:moho_factory:watch": "jest --watch tests/mohoShowBibleSchema.test.ts tests/mohoShowBibleLoader.test.ts tests/mohoCrossReferenceGating.test.ts",
    "demo:moho_factory_scaffold": "node --experimental-strip-types --no-warnings -e \"import('./src/tools/mohoShowBibleScaffold.js').then(m => console.log('Use mcp tool moho.show_bible.scaffold'))\"",
    "demo:moho_factory": "node scripts/demo_moho_factory.js",
    "test:moho_factory:acceptance": "jest tests/mohoAcceptance95.test.ts",
    "test:moho:v3": "jest --runInBand tests/mohoProductionV3Schemas.test.ts tests/mohoProductionV3Store.test.ts tests/mohoProductionV3Orchestrator.test.ts tests/mohoProductionV3Providers.test.ts tests/mohoProductionV3Alignment.test.ts tests/mohoProductionV3Compiler.test.ts tests/mohoProductionV3NativeBackend.test.ts tests/mohoProductionV3StageExecutor.test.ts tests/mohoProductionV3Tools.test.ts tests/mohoProductionV3Certification.test.ts",
    "moho:v3:certify": "npm run build && node scripts/certify_moho_v3_benchmark.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^0.6.0",
    "canonicalize": "^3.0.0",
    "dotenv": "^16.4.5",
    "fast-json-stable-stringify": "^2.1.0",
    "openai": "^7.8.0",
    "sqlite3": "^5.1.7",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/sqlite3": "^3.1.11",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "author": "Pipeline TD & Backend Engineer",
  "license": "MIT"
}
