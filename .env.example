# Path to Harmony installation (e.g. /Applications/Toon Boom Harmony 24 Premium or C:\Program Files\Toon Boom Animation\Toon Boom Harmony 24 Premium)
HARMONY_INSTALL=

# Paths to Harmony binaries (optional, will auto-detect if empty)
HARMONY_CC_BIN=
HARMONY_BIN=
HARMONY_PYTHON_PACKAGES=

# Control Center connection details (Telnet / Script Server mode)
HARMONY_CC_HOST=127.0.0.1
HARMONY_CC_PORT=1234
HARMONY_CC_USER=usabatch

# Execution options
HARMONY_SCRIPT_TIMEOUT_MS=10000

# Safety and access restrictions
HARMONY_DRY_RUN_DEFAULT=true
HARMONY_ALLOW_DESTRUCTIVE=false
HARMONY_ALLOW_RAW_SCRIPTS=false

# Comma-separated list of absolute paths allowed for operations
# Defaults to the project root (computed from config.ts location)
# Override with absolute paths, e.g.: /path/to/project,/another/path
HARMONY_ALLOWED_ROOTS=

# Log settings
HARMONY_LOG_DIR=./logs

# Video reconstruction core security
RECONSTRUCTION_API_KEY=
RECONSTRUCTION_RATE_LIMIT=120
RECONSTRUCTION_CORE_URL=http://127.0.0.1:8765
RECONSTRUCTION_CACHE_ROOT=./output/reconstruction-cache
RECONSTRUCTION_MODEL_ROOT=./models/reconstruction
RECONSTRUCTION_DEVICE=cpu
RECONSTRUCTION_MAX_CONCURRENT_JOBS=1
RECONSTRUCTION_REQUEST_TIMEOUT_MS=600000
RECONSTRUCTION_MAX_DURATION_SECONDS=300
RECONSTRUCTION_MAX_WIDTH=4096
RECONSTRUCTION_MAX_HEIGHT=4096
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Harmony Action Recorder v1 ---
# Immutable per-session evidence store. One directory per capture session; never reused.
HARMONY_CAPTURE_ARTIFACT_ROOT=./artifacts/harmony-captures
# Quiet period after the last SceneChangeNotifier signal before dirty entities are re-read.
HARMONY_CAPTURE_DEBOUNCE_MS=750
# Size limits. Exceeding one raises CAPTURE_LIMIT_EXCEEDED instead of silently truncating.
HARMONY_CAPTURE_MAX_NODES=5000
HARMONY_CAPTURE_MAX_COLUMNS=5000
HARMONY_CAPTURE_MAX_KEYFRAMES=100000
HARMONY_CAPTURE_MAX_EVENTS=50000
# Comma-separated scene roots. Empty falls back to HARMONY_ALLOWED_ROOTS.
HARMONY_CAPTURE_ALLOWED_SCENE_ROOTS=
# Artifacts store scenePathHash instead of the raw path.
HARMONY_CAPTURE_REDACT_SCENE_PATHS=true
# Comma-separated strings that must never appear in an exported dataset entry.
HARMONY_CAPTURE_REDACT_PATTERNS=
# Per-category capture switches. A disabled category is emptied AND warned about.
HARMONY_CAPTURE_CATEGORY_NODES=true
HARMONY_CAPTURE_CATEGORY_CONNECTIONS=true
HARMONY_CAPTURE_CATEGORY_NODE_ATTRIBUTES=true
HARMONY_CAPTURE_CATEGORY_COLUMNS=true
HARMONY_CAPTURE_CATEGORY_KEYFRAMES=true
HARMONY_CAPTURE_CATEGORY_EXPOSURES=true
HARMONY_CAPTURE_CATEGORY_CAMERA=true
# Real-Harmony smoke test gate (see docs/HARMONY_ACTION_RECORDER.md).
HARMONY_ACTION_RECORDER_REAL_SMOKE=
HARMONY_ACTION_RECORDER_REAL_SCENE=

# =============================================================================
# Active animation host
# =============================================================================
# Selects which animation package this process serves. One server, two hosts:
# the choice is fixed once at startup and exactly one tool set is exposed —
# never both. Harmony (~561 tools) and Moho (~45 tools) together would push 600+
# tool descriptions into the model's context on every run and degrade tool
# choice, so mixing is deliberately not supported.
#
#   harmony -> only harmony.* tools (default; this project started as Harmony)
#   moho    -> only moho.* tools
#
# An unknown value fails loudly at startup instead of silently falling back to
# harmony: a typo must not hand you 561 unrelated tools while Moho looks broken.
# Convenience scripts: `npm run start:moho`, `npm run dev:moho`.
ANIM_HOST=harmony

# =============================================================================
# Moho bridge (only read when ANIM_HOST=moho)
# =============================================================================
# The Moho bridge talks to the Lua plugin over a file-based IPC directory —
# there is no network socket. Install the plugin with:
#   npm run install:moho-plugin
# Every variable below is optional; each has a safe built-in default. An empty
# or malformed numeric value falls back to the default rather than erroring.

# IPC handshake directory, shared by this server and the Moho Lua plugin.
# Must match the plugin's directory or the two never see each other.
# Empty = per-user OS default, created lazily with 0700 permissions:
#   macOS   ~/Library/Application Support/MohoMCP/ipc
#   Windows %LOCALAPPDATA%\MohoMCP\ipc
#   Linux   ~/.moho_mcp/ipc
# MOHO_IPC_DIR is accepted as an alias and takes precedence if both are set.
MOHO_MCP_IPC_DIR=
MOHO_IPC_DIR=

# --- Dangerous capabilities: OFF by default, opt-in only ---------------------
# Both flags below are disabled unless explicitly enabled. They are the only
# features that reach outside the IPC protocol and touch the operator's real
# desktop session, so silent-by-default would be an unpleasant surprise:
# an agent could move the mouse or capture the screen without anyone asking.
# Enable them consciously, per machine, and never on a shared or CI host.
#
# Screen/window capture of the Moho window. Screenshots can leak whatever else
# is visible on screen, so capture stays off until requested.
MOHO_MCP_ENABLE_SCREENSHOTS=false
# Synthetic keyboard/mouse input driven into the Moho window. This is remote
# control of a real GUI: a wrong click is not undoable by the protocol. Guarded
# even when enabled — foreground-only, bounded to the Moho window, rate limited,
# with Ctrl+Alt+Shift+X as an emergency stop.
MOHO_MCP_ENABLE_UI_AUTOMATION=false
# Max synthetic input events per second while UI automation is enabled (1..60).
MOHO_MCP_UI_AUTOMATION_RATE_PER_SEC=10
# Append-only log of every synthetic input event. Empty = no UI audit log.
MOHO_MCP_UI_AUDIT_LOG=

# --- Timeouts and polling (milliseconds) -------------------------------------
# How often the IPC directory is polled for a plugin reply (10..5000).
MOHO_MCP_POLL_INTERVAL_MS=100
# Budget for one ordinary request (1000..300000).
MOHO_MCP_REQUEST_TIMEOUT_MS=10000
# Budget for render requests, which legitimately take longer (1000..600000).
MOHO_MCP_RENDER_TIMEOUT_MS=30000
# Per-operation slice of a batch's total budget (50..60000).
MOHO_MCP_BATCH_TIMEOUT_PER_OP_MS=500
# Age at which an unanswered request file is abandoned (1000..600000).
MOHO_MCP_REQUEST_TTL_MS=30000
# Lifetime of a cached preview artifact (1000..600000).
MOHO_MCP_PREVIEW_TTL_MS=60000
# Lifetime of the single-client lock, so a crashed client cannot wedge the
# bridge forever (1000..60000).
MOHO_MCP_CLIENT_LOCK_TTL_MS=5000

# --- Limits (reject oversized work instead of degrading) ---------------------
# Max operations in one batch call (1..500).
MOHO_MCP_MAX_BATCH_SIZE=50
# Max requests queued before new ones are refused (1..1000).
MOHO_MCP_MAX_QUEUE_SIZE=50
# Max accepted IPC JSON payload in bytes (1024..67108864). Default 10 MiB;
# a cap is required because the plugin writes untrusted files.
MOHO_MCP_MAX_JSON_SIZE_BYTES=10485760

# --- Security ---------------------------------------------------------------
# Paths the Moho tools may read from or write to, separated by the platform
# path delimiter (":" on macOS/Linux, ";" on Windows). Empty = no extra
# directories are granted.
MOHO_MCP_ALLOWED_DIRS=
# Keep the Moho bridge strictly local. On by default: the bridge is
# file-IPC only and has no legitimate reason to reach the network.
MOHO_MCP_NO_OUTBOUND_TRAFFIC=true
# Audit log of Moho tool calls. Empty = ~/.moho_mcp/audit.log
MOHO_MCP_AUDIT_LOG=

# --- Compatibility and diagnostics ------------------------------------------
# Expose the pre-rename tool aliases (e.g. document_getInfo) alongside the
# canonical moho.document.get_info names. Off by default: duplicate names bloat
# the tool list and make the model's choice worse. Enable only while migrating
# an older client.
MOHO_MCP_ENABLE_LEGACY_ALIASES=false
# Debug log of bridge activity. Empty = disabled (no file is written).
MOHO_MCP_LOG_FILE=
# Version string reported to the MCP client. Empty = built-in default.
MOHO_MCP_VERSION=
