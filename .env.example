# Path to Harmony installation (e.g. /Applications/Toon Boom Harmony 24 Premium or C:\Program Files\Toon Boom Animation\Toon Boom Harmony 24 Premium)
HARMONY_INSTALL=

# Paths to Harmony binaries (optional, will auto-detect if empty)
HARMONY_CC_BIN=
HARMONY_BIN=
HARMONY_PYTHON_PACKAGES=

# Control Center connection details (Telnet / Script Server mode)
HARMONY_CC_HOST=127.0.0.1
HARMONY_CC_PORT=1234
HARMONY_CC_USER=usabatch

# Execution options
HARMONY_SCRIPT_TIMEOUT_MS=10000

# Safety and access restrictions
HARMONY_DRY_RUN_DEFAULT=true
HARMONY_ALLOW_DESTRUCTIVE=false
HARMONY_ALLOW_RAW_SCRIPTS=false

# Comma-separated list of absolute paths allowed for operations
# Defaults to the project root (computed from config.ts location)
# Override with absolute paths, e.g.: /path/to/project,/another/path
HARMONY_ALLOWED_ROOTS=

# Log settings
HARMONY_LOG_DIR=./logs

# Video reconstruction core security
RECONSTRUCTION_API_KEY=
RECONSTRUCTION_RATE_LIMIT=120
RECONSTRUCTION_CORE_URL=http://127.0.0.1:8765
RECONSTRUCTION_CACHE_ROOT=./output/reconstruction-cache
RECONSTRUCTION_MODEL_ROOT=./models/reconstruction
RECONSTRUCTION_DEVICE=cpu
RECONSTRUCTION_MAX_CONCURRENT_JOBS=1
RECONSTRUCTION_REQUEST_TIMEOUT_MS=600000
RECONSTRUCTION_MAX_DURATION_SECONDS=300
RECONSTRUCTION_MAX_WIDTH=4096
RECONSTRUCTION_MAX_HEIGHT=4096
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Harmony Action Recorder v1 ---
# Immutable per-session evidence store. One directory per capture session; never reused.
HARMONY_CAPTURE_ARTIFACT_ROOT=./artifacts/harmony-captures
# Quiet period after the last SceneChangeNotifier signal before dirty entities are re-read.
HARMONY_CAPTURE_DEBOUNCE_MS=750
# Size limits. Exceeding one raises CAPTURE_LIMIT_EXCEEDED instead of silently truncating.
HARMONY_CAPTURE_MAX_NODES=5000
HARMONY_CAPTURE_MAX_COLUMNS=5000
HARMONY_CAPTURE_MAX_KEYFRAMES=100000
HARMONY_CAPTURE_MAX_EVENTS=50000
# Comma-separated scene roots. Empty falls back to HARMONY_ALLOWED_ROOTS.
HARMONY_CAPTURE_ALLOWED_SCENE_ROOTS=
# Artifacts store scenePathHash instead of the raw path.
HARMONY_CAPTURE_REDACT_SCENE_PATHS=true
# Comma-separated strings that must never appear in an exported dataset entry.
HARMONY_CAPTURE_REDACT_PATTERNS=

# Moho Production v3: OpenRouter-only free-model policy.
# Never commit a real key. Every configured model must end with :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
MOHO_OPENROUTER_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
MOHO_OPENROUTER_VISION_MODEL=dots-studio/dots-3-note-preview:free
# Keep empty until OpenRouter publishes a verified free image-generation model.
MOHO_OPENROUTER_IMAGE_MODEL=
# Per-category capture switches. A disabled category is emptied AND warned about.
HARMONY_CAPTURE_CATEGORY_NODES=true
HARMONY_CAPTURE_CATEGORY_CONNECTIONS=true
HARMONY_CAPTURE_CATEGORY_NODE_ATTRIBUTES=true
HARMONY_CAPTURE_CATEGORY_COLUMNS=true
HARMONY_CAPTURE_CATEGORY_KEYFRAMES=true
HARMONY_CAPTURE_CATEGORY_EXPOSURES=true
HARMONY_CAPTURE_CATEGORY_CAMERA=true
# Real-Harmony smoke test gate (see docs/HARMONY_ACTION_RECORDER.md).
HARMONY_ACTION_RECORDER_REAL_SMOKE=
HARMONY_ACTION_RECORDER_REAL_SCENE=
