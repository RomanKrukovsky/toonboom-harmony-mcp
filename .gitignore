# Временные файлы и сборка
node_modules/
dist/
.env
*.db
*.log
logs/

# Зарезервировано под IDE
.vscode/
.idea/
.DS_Store

# Сгенерированные артефакты демо/тестов
output/
examples/commercial-demo/temp_*/

# Виртуальные окружения (все локальные venv одним паттерном)
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Model weights
*.onnx
*.pth
*.bin
*.pt
weights/
# Weight blobs stay out, but the manifest carries verified SHA-256s and must be reviewable.
# The generic `weights/` rule above excludes the directory, so each level is re-included
# explicitly before the manifest exception can apply.
!services/ml-runtime/weights/
services/ml-runtime/weights/*
!services/ml-runtime/weights/dwpose/
services/ml-runtime/weights/dwpose/*
!services/ml-runtime/weights/dwpose/manifest.json

# Harmony Action Recorder evidence (local capture data, never committed)
artifacts/harmony-captures/
# Real-smoke capture data stays local; only blocked.json / verified.json are committed
docs/evidence/harmony-action-recorder-real-smoke/captures/

# Video fixtures may contain a real person; keep them local. README stays tracked.
fixtures/video/*
!fixtures/video/README.md
!fixtures/video/*.source.json

# Стенд testrig: рендеры и видео — артефакты, не исходники
*.mp4
harmony/client/testrig/out_*.png
harmony/client/out_*.png
