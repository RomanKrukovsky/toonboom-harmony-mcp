    {"shotId":"p95-14","category":"dialogue","artworkMode":"flat_characters","hasDialogue":true,"subjectKind":"animal","activeCharacterCount":4,"characterId":"animal_a","view":"three_quarter","size":"medium","durationFrames":156,"brief":"Calm explanation with overlapping listener reactions.","dialogueText":"There is another way through the old garden."},
    {"shotId":"p95-15","category":"dialogue","artworkMode":"flat_scene","hasDialogue":true,"subjectKind":"creature","activeCharacterCount":5,"characterId":"creature_a","view":"side","size":"full","durationFrames":180,"brief":"Dialogue during a slow turn with occlusion.","dialogueText":"Keep walking and do not look behind you."},
